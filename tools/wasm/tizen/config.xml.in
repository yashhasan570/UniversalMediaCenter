<?xml version="1.0" encoding="UTF-8"?>
<widget xmlns="http://www.w3.org/ns/widgets" xmlns:tizen="http://tizen.org/ns/widgets" id="https://universalmediacenter.tv/Universal Media Center" version="@APP_VERSION_CODE@" viewmodes="maximized">
   <name>Universal Media Center for Tizen</name>
   <content src="index.html"></content>
   <icon src="icon.png"></icon>
   <access origin="*" subdomains="true"></access>
   <feature name="http://tizen.org/feature/screen.size.normal.1080.1920"></feature>
   <tizen:setting screen-orientation="landscape" context-menu="enable" background-support="disable" encryption="disable" install-location="auto" hwkey-event="enable"></tizen:setting>
   <tizen:application id="universalmediacenterplayer.Universal Media Center" package="universalmediacenterplayer" required_version="6.5"></tizen:application>
   <tizen:privilege name="http://tizen.org/privilege/internet"></tizen:privilege>
   <tizen:privilege name="http://developer.samsung.com/privilege/network.public"></tizen:privilege>
   <tizen:privilege name="http://developer.samsung.com/privilege/productinfo"></tizen:privilege>
   <tizen:metadata key="http://samsung.com/tv/metadata/use.conformant" value="floating"></tizen:metadata>
   <tizen:metadata key="http://tizen.org/metadata/app_ui_type/base_screen_resolution" value="extensive"></tizen:metadata>
   <tizen:profile name="tv-samsung"></tizen:profile>
</widget>
