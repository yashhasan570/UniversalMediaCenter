    <summary>Ultimate entertainment center</summary>
    <url type="homepage">https://github.com/yashhasan570/UniversalMediaCenter/</url>
    <url type="donation">https://github.com/yashhasan570/UniversalMediaCenter/contribute/donate</url>
    <url type="bugtracker">https://github.com///issues</url>
    <url type="faq">https://github.com/yashhasan570/UniversalMediaCenter/wiki/view/FAQs</url>
    <url type="help">@FORUM_WEBSITE@</url>
    <url type="translate">https://universalmediacenter.weblate.cloud/</url>
    <url type="contribute">https://github.com///blob/master/docs/CONTRIBUTING.md</url>
    <url type="vcs-browser">https://github.com///</url>
    <description>
        <p>Universal Media Center allows users to play and view videos, music, podcasts,
        and other digital media files from local storage, network storage
        and the internet. It's optimized for a 10-foot user interface to be
        used with televisions and remote controls.</p>

        <p>Universal Media Center spawned from the love of media. It is an entertainment hub
        that brings all your digital media together into a beautiful
        and user friendly package. It is 100% free and open source,
        very customisable and runs on a wide variety of devices. It is
        supported by a dedicated team of volunteers and a huge community.</p>
    </description>
    <keywords>
        <keyword>Universal Media Center</keyword>
        <keyword></keyword>
        <keyword>audio</keyword>
        <keyword>video</keyword>
        <keyword>media</keyword>
        <keyword>media center</keyword>
        <keyword>music</keyword>
        <keyword>tv</keyword>
        <keyword>television</keyword>
        <keyword>remote control</keyword>
    </keywords>
    <launchable type="desktop-id">@APP_NAME_LC@.desktop</launchable>
    <screenshots>
        <screenshot type="default">
            <image>https://mirrors.github.com/yashhasan570/UniversalMediaCenter/screenshots/universalmediacenter-recently-added.jpg</image>
            <caption>The homescreen keeps your media organized</caption>
        </screenshot>
        <screenshot>
            <image>https://mirrors.github.com/yashhasan570/UniversalMediaCenter/screenshots/universalmediacenter-videolibrary.jpg</image>
            <caption>Easily browse your movies and series</caption>
        </screenshot>
        <screenshot>
            <image>https://mirrors.github.com/yashhasan570/UniversalMediaCenter/screenshots/universalmediacenter-video-info.jpg</image>
            <caption>Get additional infos about your movies or series</caption>
        </screenshot>
        <screenshot>
            <image>https://mirrors.github.com/yashhasan570/UniversalMediaCenter/screenshots/universalmediacenter-tvshow.jpg</image>
            <caption>Browse TV shows by seasons</caption>
        </screenshot>
        <screenshot>
            <image>https://mirrors.github.com/yashhasan570/UniversalMediaCenter/screenshots/universalmediacenter-music-info.jpg</image>
            <caption>Use the music library to organize and read about your artists</caption>
        </screenshot>
        <screenshot>
            <image>https://mirrors.github.com/yashhasan570/UniversalMediaCenter/screenshots/universalmediacenter-epg.jpg</image>
            <caption>Use the EPG to manage your TV stations</caption>
        </screenshot>
        <screenshot>
            <image>https://mirrors.github.com/yashhasan570/UniversalMediaCenter/screenshots/universalmediacenter-addons.jpg</image>
            <caption>Extend what Universal Media Center can do, just use addons</caption>
        </screenshot>
        <screenshot>
            <image>https://mirrors.github.com/yashhasan570/UniversalMediaCenter/screenshots/universalmediacenter-weather.jpg</image>
            <caption>Keep the weather in check</caption>
        </screenshot>
        <screenshot>
            <image>https://mirrors.github.com/yashhasan570/UniversalMediaCenter/screenshots/universalmediacenter-webinterface.jpg</image>
            <caption>The webinterface enables you to manage your Universal Media Center from other devices</caption>
        </screenshot>
    </screenshots>
