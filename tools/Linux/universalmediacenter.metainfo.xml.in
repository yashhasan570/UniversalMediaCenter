    <id>@APP_PACKAGE@</id>
    <name>@APP_NAME@</name>
    <project_license>GPL-2.0-only GPL-2.0-or-later LGPL-2.1-or-later MIT BSD-3-Clause BSD-4-Clause</project_license>
