package @APP_PACKAGE@;

import android.util.Log;

/**
 * Created by koyin on 07/01/2018.
 */

public class File
{
  native boolean _open(String path);
  native void _close();
  native byte[] _read();
  native boolean _eof();

  private static String TAG = "@APP_NAME@";

  public File()
  {

  }

  public boolean Open(String path)
  {
    try
    {
      return _open(path);
    }
    catch (Exception e)
    {
      e.printStackTrace();
      Log.e(TAG, "File.Open: Exception");
      return false;
    }
    catch (UnsatisfiedLinkError e)
    {
      Log.e(TAG, "File.Open: Not available");
      return false;
    }
  }

  public void Close()
  {
    try
    {
      _close();
    }
    catch (Exception e)
    {
      e.printStackTrace();
      Log.e(TAG, "File.Close: Exception");
      return;
    }
    catch (UnsatisfiedLinkError e)
    {
      Log.e(TAG, "File.Close: Not available");
      return;
    }
  }

  public byte[] Read()
  {
    try
    {
      return _read();
    }
    catch (Exception e)
    {
      e.printStackTrace();
      Log.e(TAG, "File.Read: Exception");
      return new byte[0];
    }
    catch (UnsatisfiedLinkError e)
    {
      Log.e(TAG, "File.Read: Not available");
      return new byte[0];
    }
  }

  public boolean Eof()
  {
    try
    {
      return _eof();
    }
    catch (Exception e)
    {
      e.printStackTrace();
      Log.e(TAG, "File.Eof: Exception");
      return false;
    }
    catch (UnsatisfiedLinkError e)
    {
      Log.e(TAG, "File.Eof: Not available");
      return false;
    }
  }

}
