<?xml version="1.0" encoding="UTF-8"?>
<addon
  id="resource.language.en_gb"
  version="2.0.2"
  name="English"
  provider-name="Team Universal Media Center">
  <requires>
    <import addon="universalmediacenter.resource" version="1.0.0"/>
  </requires>
  <extension
    point="universalmediacenter.resource.language"
    locale="en_GB">
    <charsets>
      <gui>CP1252</gui>
      <subtitle>CP1252</subtitle>
    </charsets>
    <sorttokens>
      <token>The</token>
    </sorttokens>
  </extension>
  <extension point="universalmediacenter.addon.metadata">
    <summary lang="en">English language pack</summary>
    <description lang="en">English version of all texts used in Universal Media Center.</description>
    <disclaimer lang="en">English is the default language for Universal Media Center, removing it may cause issues</disclaimer>
    <platform>all</platform>
    <assets>
      <icon>icon.png</icon>
    </assets>
  </extension>
</addon>
