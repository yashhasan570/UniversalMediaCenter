msgstr "Vælg hvilken bitrate der skal bruges af WMA-lydindkoderen til lydkomprimering."

#. Value format for with bitrate edited field
#: resources/settings.xml
msgctxt "#30002"
msgid "{0:d} kbps"
msgstr "{0:d} kb/s"
