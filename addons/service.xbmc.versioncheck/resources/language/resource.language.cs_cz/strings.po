msgctxt "Addon Summary"
msgid "Universal Media Center Version Check checks if you are running latest released version."
msgstr "Kontrola verze Universal Media Center, zkontroluje, zda používáte nejnovější vydanou verzi."

msgctxt "Addon Description"
msgid "Universal Media Center Version Check only supports a number of platforms/distros as releases may differ between them. For more information visit the github.com/yashhasan570/UniversalMediaCenter website."
msgstr "Kontrola verze Universal Media Center podporuje pouze několik platforem/distribucí a verze mezi nimi se můžou lišit. Pro více informací navštivte webové stránky github.com/yashhasan570/UniversalMediaCenter."

msgctxt "Addon Disclaimer"
msgid "Feel free to use this script. For information visit github.com/yashhasan570/UniversalMediaCenter"
msgstr "Neváhejte použít tento skript. Pro více informací navštivte github.com/yashhasan570/UniversalMediaCenter"

msgctxt "#32001"
msgid "We would like to recommend you to upgrade."
msgstr "Rádi bychom vám doporučili upgrade."

msgctxt "#32002"
msgid "Visit Universal Media Center.tv for more information."
msgstr "Navštivte Universal Media Center.tv pro více informací."

msgctxt "#32009"
msgid "Would you like to remove this reminder?"
msgstr "Chtěli byste odstranit tuto připomínku?"

msgctxt "#32010"
msgid "You can enable/disable it through add-on settings."
msgstr "Je možno povolit/zakázat v nastavení doplňku."

msgctxt "#32011"
msgid "Use your package manager(apt) to upgrade."
msgstr "Použijte správce balíčků (APT) k upgradu."

msgctxt "#32012"
msgid "A new version is available, do you want to upgrade now?"
msgstr "Nová verze je k dispozici, chcete upgradovat nyní?"

msgctxt "#32013"
msgid "Upgrade successful"
msgstr "Aktualizace úspěšná"

msgctxt "#32014"
msgid "Do you want to restart Universal Media Center to finish the upgrade?"
msgstr "Chcete restartovat Universal Media Center pro dokončení aktualizace?"

msgctxt "#32015"
msgid "Do you want to check the repository for a new version?"
msgstr "Chcete zjistit, jestli je v repositáři nová verze?"

msgctxt "#32016"
msgid "There is a newer stable Universal Media Center version available."
msgstr "Je k dispozici nová verze Universal Media Center."

msgctxt "#32020"
msgid "General"
msgstr "Obecné"

msgctxt "#32021"
msgid "Enable Universal Media Center version check?"
msgstr "Povolit kontrolu verze Universal Media Center?"

msgctxt "#32022"
msgid "Please enter your password"
msgstr "Prosím, zadejte své heslo"

msgctxt "#32023"
msgid "Linux: Upgrade complete system"
msgstr "Linux: Aktualizace celého systému"

msgctxt "#32024"
msgid "Linux: Upgrade using apt"
msgstr "Linux: Aktualizace za použití apt"

#. Used in OK dialog
msgctxt "#32030"
msgid "A new stable version of Universal Media Center is available."
msgstr "Je k dispozici nová stabilní verze Universal Media Center."

#. Direct people to the website. Used in OK dialog
msgctxt "#32031"
msgid "Visit http://github.com/yashhasan570/UniversalMediaCenter for more information."
msgstr "Navštivte http://github.com/yashhasan570/UniversalMediaCenter pro více informací."

#. Used in OK dialog
msgctxt "#32032"
msgid "A new stable version of Universal Media Center is available."
msgstr "Je k dispozici nová stabilní verze Universal Media Center."

#. Direct people to the website. Used in OK dialog
msgctxt "#32033"
msgid "Visit http://github.com/yashhasan570/UniversalMediaCenter for more information."
msgstr "Navštivte http://github.com/yashhasan570/UniversalMediaCenter pro více informací."

#. For example: "You are using 13.1 prealpha while 13.2 stable is available"
msgctxt "#32034"
msgid "Using %s while %s is available."
msgstr "Používáte %s, ale už je k dispozici %s."

#. Used in OK dialog
msgctxt "#32035"
msgid "It is recommended that you upgrade to a newer version."
msgstr "Je doporučeno upgradovat na novou verzi."

# empty strings from id 32036 to 32039
msgctxt "#32040"
msgid "Your version %s of the Python cryptography module is too old. You need at least version 1.7."
msgstr "Vaše verze %s Python kryptografického modulu je příliš stará. Potřebujete minimálně verzi 1.7."

msgctxt "#32041"
msgid "Please upgrade your operating system."
msgstr "Prosím aktualizujte váš operační systém."

msgctxt "#32042"
msgid "For more information, see https://github.com/yashhasan570/UniversalMediaCenter/wiki/view/Linux"
msgstr "Pro více informací navštivte https://github.com/yashhasan570/UniversalMediaCenter/wiki/view/Linux"

#~ msgctxt "#32035"
#~ msgid "It is recommended that you to upgrade to a newer version."
#~ msgstr "Je doporučeno upgradovat na novější verzi."
