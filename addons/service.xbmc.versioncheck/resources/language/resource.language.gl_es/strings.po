msgctxt "Addon Summary"
msgid "Universal Media Center Version Check checks if you are running latest released version."
msgstr "Universal Media Center Version Check verifica se está a executar a última versión."

msgctxt "Addon Description"
msgid "Universal Media Center Version Check only supports a number of platforms/distros as releases may differ between them. For more information visit the github.com/yashhasan570/UniversalMediaCenter website."
msgstr "Universal Media Center Version Check só soporta un número limitado de plataformas/distribucións, xa que os lanzamentos poden diferir entre eles. Para máis información visitar o sitio web de github.com/yashhasan570/UniversalMediaCenter."

msgctxt "Addon Disclaimer"
msgid "Feel free to use this script. For information visit github.com/yashhasan570/UniversalMediaCenter"
msgstr "Síntase libre de usar este script, para máis información visitar github.com/yashhasan570/UniversalMediaCenter."

msgctxt "#32001"
msgid "We would like to recommend you to upgrade."
msgstr "Gustaríanos recomendarlle actualizar."

msgctxt "#32002"
msgid "Visit Universal Media Center.tv for more information."
msgstr "Visitar Universal Media Center.tv para máis información."

msgctxt "#32009"
msgid "Would you like to remove this reminder?"
msgstr "Quere eliminar este aviso?"

msgctxt "#32010"
msgid "You can enable/disable it through add-on settings."
msgstr "Pode des/activalo a través dos axustes do complemento."

msgctxt "#32011"
msgid "Use your package manager(apt) to upgrade."
msgstr "Use o xestor de paquetes(apt) para actualizar."

msgctxt "#32012"
msgid "A new version is available, do you want to upgrade now?"
msgstr "Hai unha nova versión dispoñíbel, quere actualizar agora?"

msgctxt "#32013"
msgid "Upgrade successful"
msgstr "Actualización correcta"

msgctxt "#32014"
msgid "Do you want to restart Universal Media Center to finish the upgrade?"
msgstr "Quere reiniciar agora o Universal Media Center para rematar a actualización?"

msgctxt "#32015"
msgid "Do you want to check the repository for a new version?"
msgstr "Quere buscar no repositorio unha nova versión?"

msgctxt "#32016"
msgid "There is a newer stable Universal Media Center version available."
msgstr "Hai dispoñíbel unha nova versión estábel do Universal Media Center."

msgctxt "#32020"
msgid "General"
msgstr "Xeral"

msgctxt "#32021"
msgid "Enable Universal Media Center version check?"
msgstr "Activar a verificación de versión do Universal Media Center?"

msgctxt "#32022"
msgid "Please enter your password"
msgstr "Por favor introduza o seu contrasinal"

msgctxt "#32023"
msgid "Linux: Upgrade complete system"
msgstr "Linux: Actualizar o sistema completo"

msgctxt "#32024"
msgid "Linux: Upgrade using apt"
msgstr "Linux: Actualizar empregando apt"

#. Used in OK dialog
msgctxt "#32030"
msgid "A new stable version of Universal Media Center is available."
msgstr "Está dispoñible unha versión estable nova de Universal Media Center."

#. Direct people to the website. Used in OK dialog
msgctxt "#32031"
msgid "Visit http://github.com/yashhasan570/UniversalMediaCenter for more information."
msgstr "Ir a http://github.com/yashhasan570/UniversalMediaCenter para máis información."

#. Used in OK dialog
msgctxt "#32032"
msgid "A new stable version of Universal Media Center is available."
msgstr "Está dispoñíbel unha nova versión estábel de Universal Media Center."

#. Direct people to the website. Used in OK dialog
msgctxt "#32033"
msgid "Visit http://github.com/yashhasan570/UniversalMediaCenter for more information."
msgstr "Ir a http://github.com/yashhasan570/UniversalMediaCenter para máis información."

#. For example: "You are using 13.1 prealpha while 13.2 stable is available"
msgctxt "#32034"
msgid "Using %s while %s is available."
msgstr "Está a empregar a versión %s mentres que a %s está dispoñíbel."

#. Used in OK dialog
msgctxt "#32035"
msgid "It is recommended that you upgrade to a newer version."
msgstr "É recomendábel actualizar á nova versión."

# empty strings from id 32036 to 32039
msgctxt "#32040"
msgid "Your version %s of the Python cryptography module is too old. You need at least version 1.7."
msgstr ""

msgctxt "#32041"
msgid "Please upgrade your operating system."
msgstr ""

msgctxt "#32042"
msgid "For more information, see https://github.com/yashhasan570/UniversalMediaCenter/wiki/view/Linux"
msgstr ""

