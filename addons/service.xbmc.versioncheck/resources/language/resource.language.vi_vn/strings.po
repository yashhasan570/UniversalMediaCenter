msgctxt "Addon Summary"
msgid "Universal Media Center Version Check checks if you are running latest released version."
msgstr "Universal Media Center Version Check kiểm tra xem bạn có đang chạy phiên bản mới nhất được phát hành hay không."

msgctxt "Addon Description"
msgid "Universal Media Center Version Check only supports a number of platforms/distros as releases may differ between them. For more information visit the github.com/yashhasan570/UniversalMediaCenter website."
msgstr "Universal Media Center Version Check chỉ hỗ trợ một số nền tảng/phân phối vì các bản phát hành có thể khác nhau giữa chúng. Để biết thêm thông tin, hãy truy cập trang web github.com/yashhasan570/UniversalMediaCenter."

msgctxt "Addon Disclaimer"
msgid "Feel free to use this script. For information visit github.com/yashhasan570/UniversalMediaCenter"
msgstr "Hãy sử dụng tập lệnh này. Để biết thêm thông tin, truy cập github.com/yashhasan570/UniversalMediaCenter"

msgctxt "#32001"
msgid "We would like to recommend you to upgrade."
msgstr "Chúng tôi gợi ý bạn nên nâng cấp."

msgctxt "#32002"
msgid "Visit Universal Media Center.tv for more information."
msgstr "Truy cập Universal Media Center.tv để biết thêm thông tin."

# empty strings from id 32003 to 32008
msgctxt "#32009"
msgid "Would you like to remove this reminder?"
msgstr "Bạn có muốn xóa lời nhắc này không?"

msgctxt "#32010"
msgid "You can enable/disable it through add-on settings."
msgstr "Bạn có thể bật/tắt nó thông qua cài đặt tiện ích."

msgctxt "#32011"
msgid "Use your package manager(apt) to upgrade."
msgstr ""

msgctxt "#32012"
msgid "A new version is available, do you want to upgrade now?"
msgstr "Đã có phiên bản mới, bạn có muốn nâng cấp ngay bây giờ không?"

msgctxt "#32013"
msgid "Upgrade successful"
msgstr "Nâng cấp thàng công"

msgctxt "#32014"
msgid "Do you want to restart Universal Media Center to finish the upgrade?"
msgstr "Bạn có muốn khởi động lại Universal Media Center để hoàn tất nâng cấp không?"

msgctxt "#32015"
msgid "Do you want to check the repository for a new version?"
msgstr "Bạn có muốn kiểm tra kho lưu trữ để tìm phiên bản mới không?"

msgctxt "#32016"
msgid "There is a newer stable Universal Media Center version available."
msgstr "Đã có phiên bản Universal Media Center ổn định mới hơn."

msgctxt "#32020"
msgid "General"
msgstr "Chung"

msgctxt "#32021"
msgid "Enable Universal Media Center version check?"
msgstr "Bật kiểm tra phiên bản Universal Media Center?"

msgctxt "#32022"
msgid "Please enter your password"
msgstr "Vui lòng nhập mật khẩu"

msgctxt "#32023"
msgid "Linux: Upgrade complete system"
msgstr "Linux: Nâng cấp hệ thống hoàn chỉnh"

msgctxt "#32024"
msgid "Linux: Upgrade using apt"
msgstr "Linux: Nâng cấp bằng apt"

# empty strings from id 32025 to 32029
#. Used in OK dialog
msgctxt "#32030"
msgid "A new stable version of Universal Media Center is available."
msgstr "Đã có phiên bản ổn định mới của Universal Media Center."

#. Direct people to the website. Used in OK dialog
msgctxt "#32031"
msgid "Visit http://github.com/yashhasan570/UniversalMediaCenter for more information."
msgstr "Truy cập http://github.com/yashhasan570/UniversalMediaCenter để biết thêm thông tin."

#. Used in OK dialog
msgctxt "#32032"
msgid "A new stable version of Universal Media Center is available."
msgstr "Đã có phiên bản ổn định mới của Universal Media Center."

#. Direct people to the website. Used in OK dialog
msgctxt "#32033"
msgid "Visit http://github.com/yashhasan570/UniversalMediaCenter for more information."
msgstr "Truy cập http://github.com/yashhasan570/UniversalMediaCenter để biết thêm thông tin."

#. For example: "You are using 13.1 prealpha while 13.2 stable is available"
msgctxt "#32034"
msgid "Using %s while %s is available."
msgstr "Bạn đang sử dụng %s trong khi đã có phiên bản %s."

#. Used in OK dialog
msgctxt "#32035"
msgid "It is recommended that you upgrade to a newer version."
msgstr "Bạn nên nâng cấp lên phiên bản mới hơn."

# empty strings from id 32036 to 32039
msgctxt "#32040"
msgid "Your version %s of the Python cryptography module is too old. You need at least version 1.7."
msgstr "Phiên bản %s của mô-đun mật mã Python của bạn quá cũ. Bạn cần phiên bản thấp nhất là 1.7."

msgctxt "#32041"
msgid "Please upgrade your operating system."
msgstr "Vui lòng nâng cấp hệ điều hành của bạn."

msgctxt "#32042"
msgid "For more information, see https://github.com/yashhasan570/UniversalMediaCenter/wiki/view/Linux"
msgstr "Để biết thêm thông tin, hãy xem https://github.com/yashhasan570/UniversalMediaCenter/wiki/view/Linux"

#~ msgctxt "#32035"
#~ msgid "It is recommended that you to upgrade to a newer version."
#~ msgstr "Bạn nên nâng cấp lên phiên bản mới hơn."
