msgctxt "Addon Summary"
msgid "Universal Media Center Version Check checks if you are running latest released version."
msgstr "Universal Media Center Version Check prüft, ob die neuste Version von Universal Media Center installiert ist."

msgctxt "Addon Description"
msgid "Universal Media Center Version Check only supports a number of platforms/distros as releases may differ between them. For more information visit the github.com/yashhasan570/UniversalMediaCenter website."
msgstr "Universal Media Center Version Check unterstützt nur ausgewählte Plattformen/Distributionen, da sich die jeweiligen Veröffentlichungen unterscheiden können. Mehr Informationen dazu gibt es auf der github.com/yashhasan570/UniversalMediaCenter-Website."

msgctxt "Addon Disclaimer"
msgid "Feel free to use this script. For information visit github.com/yashhasan570/UniversalMediaCenter"
msgstr "Dieses Skript ist sehr nützlich und jeder sollte es verwenden. Mehr Informationen dazu gibt es auf der github.com/yashhasan570/UniversalMediaCenter-Website"

msgctxt "#32001"
msgid "We would like to recommend you to upgrade."
msgstr "Es gibt eine Aktualisierung."

msgctxt "#32002"
msgid "Visit Universal Media Center.tv for more information."
msgstr "Mehr Informationen gibt es auf der github.com/yashhasan570/UniversalMediaCenter-Website."

msgctxt "#32009"
msgid "Would you like to remove this reminder?"
msgstr "Soll diese Erinnerung gelöscht werden?"

msgctxt "#32010"
msgid "You can enable/disable it through add-on settings."
msgstr "Dies kann in den Addon-Einstellungen aktiviert/deaktiviert werden."

msgctxt "#32011"
msgid "Use your package manager(apt) to upgrade."
msgstr "Bitte den System-Paketmanager (apt) zum Aktualisieren verwenden."

msgctxt "#32012"
msgid "A new version is available, do you want to upgrade now?"
msgstr "Eine neue Version ist verfügbar. Jetzt aktualisieren?"

msgctxt "#32013"
msgid "Upgrade successful"
msgstr "Aktualisierung erfolgreich"

msgctxt "#32014"
msgid "Do you want to restart Universal Media Center to finish the upgrade?"
msgstr "Soll Universal Media Center neu gestartet werden, um die Aktualisierung abzuschließen?"

msgctxt "#32015"
msgid "Do you want to check the repository for a new version?"
msgstr "Soll das Addon-Repository auf eine neue Version überprüft werden?"

msgctxt "#32016"
msgid "There is a newer stable Universal Media Center version available."
msgstr "Eine neuere stabile Universal Media Center-Version ist verfügbar."

msgctxt "#32020"
msgid "General"
msgstr "Allgemein"

msgctxt "#32021"
msgid "Enable Universal Media Center version check?"
msgstr "Universal Media Center-Versionsprüfung aktivieren?"

msgctxt "#32022"
msgid "Please enter your password"
msgstr "Bitte Passwort eingeben"

msgctxt "#32023"
msgid "Linux: Upgrade complete system"
msgstr "Linux: Komplettes System aktualisieren"

msgctxt "#32024"
msgid "Linux: Upgrade using apt"
msgstr "Linux: Aktualisierung durch apt"

#. Used in OK dialog
msgctxt "#32030"
msgid "A new stable version of Universal Media Center is available."
msgstr "Eine neue stabile Universal Media Center-Version ist verfügbar."

#. Direct people to the website. Used in OK dialog
msgctxt "#32031"
msgid "Visit http://github.com/yashhasan570/UniversalMediaCenter for more information."
msgstr "Mehr Informationen gibt es auf http://github.com/yashhasan570/UniversalMediaCenter."

#. Used in OK dialog
msgctxt "#32032"
msgid "A new stable version of Universal Media Center is available."
msgstr "Eine neue stabile Universal Media Center-Version ist verfügbar."

#. Direct people to the website. Used in OK dialog
msgctxt "#32033"
msgid "Visit http://github.com/yashhasan570/UniversalMediaCenter for more information."
msgstr "Mehr Informationen gibt es auf http://github.com/yashhasan570/UniversalMediaCenter."

#. For example: "You are using 13.1 prealpha while 13.2 stable is available"
msgctxt "#32034"
msgid "Using %s while %s is available."
msgstr "%s wird verwendet, obwohl %s verfügbar ist."

#. Used in OK dialog
msgctxt "#32035"
msgid "It is recommended that you upgrade to a newer version."
msgstr "Ein Upgrade auf eine neuere Version wird empfohlen."

# empty strings from id 32036 to 32039
msgctxt "#32040"
msgid "Your version %s of the Python cryptography module is too old. You need at least version 1.7."
msgstr "Die installierte Version des Python-Kryptogafiemoduls ist zu alt. Es wird mindestens Version 1.7 benötigt."

msgctxt "#32041"
msgid "Please upgrade your operating system."
msgstr "Bitte das Betriebssystem aktualisieren."

msgctxt "#32042"
msgid "For more information, see https://github.com/yashhasan570/UniversalMediaCenter/wiki/view/Linux"
msgstr "Mehr Informationen dazu gibt es unter https://github.com/yashhasan570/UniversalMediaCenter/wiki/view/Linux"

#~ msgctxt "#32035"
#~ msgid "It is recommended that you to upgrade to a newer version."
#~ msgstr "Es wird empfohlen, auf eine neuere Version zu aktualisieren."
