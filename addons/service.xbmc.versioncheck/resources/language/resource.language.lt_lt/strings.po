msgctxt "Addon Summary"
msgid "Universal Media Center Version Check checks if you are running latest released version."
msgstr "Universal Media Center Version Check patikrina ar naudojate naujausią versiją."

msgctxt "Addon Description"
msgid "Universal Media Center Version Check only supports a number of platforms/distros as releases may differ between them. For more information visit the github.com/yashhasan570/UniversalMediaCenter website."
msgstr "Universal Media Center Version Check palaiko tik kelias platformas/distribucijas, nes leidimai tarp jų gali skirtis. Norėdami gauti daugiau informacijos, apsilankykite Universal Media Center.tv puslapyje."

msgctxt "Addon Disclaimer"
msgid "Feel free to use this script. For information visit github.com/yashhasan570/UniversalMediaCenter"
msgstr "Galite laisvai naudoti šį scenarijų. Apsilankykite github.com/yashhasan570/UniversalMediaCenter, norėdami gauti daugiau informacijos."

msgctxt "#32001"
msgid "We would like to recommend you to upgrade."
msgstr "Norėtume pasiūlyti jums atsinaujinti."

msgctxt "#32002"
msgid "Visit Universal Media Center.tv for more information."
msgstr "Apsilankykite Universal Media Center.tv, norėdami gauti daugiau informacijos."

msgctxt "#32009"
msgid "Would you like to remove this reminder?"
msgstr "Ar norite paašalinti šį priminimą?"

msgctxt "#32010"
msgid "You can enable/disable it through add-on settings."
msgstr "Tai galima išjungti/įjungti priedo nustatymuose."

msgctxt "#32011"
msgid "Use your package manager(apt) to upgrade."
msgstr "Naudokite paketo tvarkyklę (apt), norėdami atnaujinti."

msgctxt "#32012"
msgid "A new version is available, do you want to upgrade now?"
msgstr "Pasiekiama nauja versija, ar norite atnaujinti dabar?"

msgctxt "#32013"
msgid "Upgrade successful"
msgstr "Atnaujinimas sėkmingas"

msgctxt "#32014"
msgid "Do you want to restart Universal Media Center to finish the upgrade?"
msgstr "Ar norite iš naujo paleisti Universal Media Center, kad užbaigti atnaujinimą?"

msgctxt "#32015"
msgid "Do you want to check the repository for a new version?"
msgstr "Ar norite patikrinti saugykloje, ar yra nauja versija?"

msgctxt "#32016"
msgid "There is a newer stable Universal Media Center version available."
msgstr "Galima naujesnė stabili Universal Media Center versija."

msgctxt "#32020"
msgid "General"
msgstr "Pagrindinis"

msgctxt "#32021"
msgid "Enable Universal Media Center version check?"
msgstr "Įjungti Universal Media Center versijos tikrinimą?"

msgctxt "#32022"
msgid "Please enter your password"
msgstr "Įveskite slaptažodį"

msgctxt "#32023"
msgid "Linux: Upgrade complete system"
msgstr "Linux: atnaujinti visą sistemą"

msgctxt "#32024"
msgid "Linux: Upgrade using apt"
msgstr "Linux: atnaujinti naudojant apt"

#. Used in OK dialog
msgctxt "#32030"
msgid "A new stable version of Universal Media Center is available."
msgstr "Galima nauja Universal Media Center versija."

#. Direct people to the website. Used in OK dialog
msgctxt "#32031"
msgid "Visit http://github.com/yashhasan570/UniversalMediaCenter for more information."
msgstr "Apsilankykite http://github.com/yashhasan570/UniversalMediaCenter, norėdami gauti daugiau informacijos."

#. Used in OK dialog
msgctxt "#32032"
msgid "A new stable version of Universal Media Center is available."
msgstr "Galima nauja stabili Universal Media Center versija."

#. Direct people to the website. Used in OK dialog
msgctxt "#32033"
msgid "Visit http://github.com/yashhasan570/UniversalMediaCenter for more information."
msgstr "Apsilankykite http://github.com/yashhasan570/UniversalMediaCenter, norėdami gauti daugiau informacijos."

#. For example: "You are using 13.1 prealpha while 13.2 stable is available"
msgctxt "#32034"
msgid "Using %s while %s is available."
msgstr "Naudojama %s, kai yra prieinama %s."

#. Used in OK dialog
msgctxt "#32035"
msgid "It is recommended that you upgrade to a newer version."
msgstr "Rekomenduojama atnaujinti į naujesnę versiją."

# empty strings from id 32036 to 32039
msgctxt "#32040"
msgid "Your version %s of the Python cryptography module is too old. You need at least version 1.7."
msgstr "Jūsų Python kriptografijos modulio %s versija yra per sena. Jums reikia bent 1.7 versijos."

msgctxt "#32041"
msgid "Please upgrade your operating system."
msgstr "Atnaujinkite savo operacinę sistemą."

msgctxt "#32042"
msgid "For more information, see https://github.com/yashhasan570/UniversalMediaCenter/wiki/view/Linux"
msgstr "Norėdami gauti daugiau informacijos, žr. https://github.com/yashhasan570/UniversalMediaCenter/wiki/view/Linux"

#~ msgctxt "#32035"
#~ msgid "It is recommended that you to upgrade to a newer version."
#~ msgstr "Rekomenduojama atnaujinti į naujesnę versiją."
