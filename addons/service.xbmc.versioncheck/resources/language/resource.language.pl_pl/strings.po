msgctxt "Addon Summary"
msgid "Universal Media Center Version Check checks if you are running latest released version."
msgstr "Dodatek Version Check sprawdza, czy używasz najnowszej wersji Universal Media Center."

msgctxt "Addon Description"
msgid "Universal Media Center Version Check only supports a number of platforms/distros as releases may differ between them. For more information visit the github.com/yashhasan570/UniversalMediaCenter website."
msgstr "Dodatek Version Check wspiera tylko część platform i dystrybucji. Więcej informacji na stronie github.com/yashhasan570/UniversalMediaCenter."

msgctxt "Addon Disclaimer"
msgid "Feel free to use this script. For information visit github.com/yashhasan570/UniversalMediaCenter"
msgstr "Zapraszamy do używania tego dodatku. Więcej informacji na stronie github.com/yashhasan570/UniversalMediaCenter"

msgctxt "#32001"
msgid "We would like to recommend you to upgrade."
msgstr "Zaleca się uaktualnienie do nowszej wersji."

msgctxt "#32002"
msgid "Visit Universal Media Center.tv for more information."
msgstr "Odwiedź stronę Universal Media Center.tv po więcej informacji."

msgctxt "#32009"
msgid "Would you like to remove this reminder?"
msgstr "Usunąć to przypomnienie?"

msgctxt "#32010"
msgid "You can enable/disable it through add-on settings."
msgstr "Można to włączyć lub wyłączyć w ustawieniach dodatku."

msgctxt "#32011"
msgid "Use your package manager(apt) to upgrade."
msgstr "Używaj własnego menedżera pakietów (apt) do aktualizacji."

msgctxt "#32012"
msgid "A new version is available, do you want to upgrade now?"
msgstr "Dostępna jest nowa wersja, czy chcesz teraz aktualizować?"

msgctxt "#32013"
msgid "Upgrade successful"
msgstr "Aktualizacja powiodła się"

msgctxt "#32014"
msgid "Do you want to restart Universal Media Center to finish the upgrade?"
msgstr "Chcesz zrestartować Universal Media Center, aby dokończyć aktualizację?"

msgctxt "#32015"
msgid "Do you want to check the repository for a new version?"
msgstr "Czy chcesz sprawdzić repozytorium pod kątem nowej wersji?"

msgctxt "#32016"
msgid "There is a newer stable Universal Media Center version available."
msgstr "Dostępna jest nowa stabilna wersja Universal Media Center."

msgctxt "#32020"
msgid "General"
msgstr "Ogólne"

msgctxt "#32021"
msgid "Enable Universal Media Center version check?"
msgstr "Sprawdzać wersję Universal Media Center?"

msgctxt "#32022"
msgid "Please enter your password"
msgstr "Wprowadź hasło"

msgctxt "#32023"
msgid "Linux: Upgrade complete system"
msgstr "Linux: aktualizuj cały system"

msgctxt "#32024"
msgid "Linux: Upgrade using apt"
msgstr "Linux: aktualizuj za pomocą menedżera pakietów (apt)"

#. Used in OK dialog
msgctxt "#32030"
msgid "A new stable version of Universal Media Center is available."
msgstr "Dostępna jest nowa stabilna wersja Universal Media Center."

#. Direct people to the website. Used in OK dialog
msgctxt "#32031"
msgid "Visit http://github.com/yashhasan570/UniversalMediaCenter for more information."
msgstr "Odwiedź stronę http://github.com/yashhasan570/UniversalMediaCenter po więcej informacji."

#. Used in OK dialog
msgctxt "#32032"
msgid "A new stable version of Universal Media Center is available."
msgstr "Dostępna jest nowa stabilna wersja Universal Media Center."

#. Direct people to the website. Used in OK dialog
msgctxt "#32033"
msgid "Visit http://github.com/yashhasan570/UniversalMediaCenter for more information."
msgstr "Odwiedź stronę http://github.com/yashhasan570/UniversalMediaCenter po więcej informacji."

#. For example: "You are using 13.1 prealpha while 13.2 stable is available"
msgctxt "#32034"
msgid "Using %s while %s is available."
msgstr "Korzystasz z %s, gdy dostępna jest już wersja %s."

#. Used in OK dialog
msgctxt "#32035"
msgid "It is recommended that you upgrade to a newer version."
msgstr "Zaleca się uaktualnienie do nowszej wersji."

# empty strings from id 32036 to 32039
msgctxt "#32040"
msgid "Your version %s of the Python cryptography module is too old. You need at least version 1.7."
msgstr "Wersja %s modułu kryptograficznego Pythona jest zbyt stara. Wymagana jest co najmniej wersja 1.7."

msgctxt "#32041"
msgid "Please upgrade your operating system."
msgstr "Dokonaj uaktualnienia systemu operacyjnego."

msgctxt "#32042"
msgid "For more information, see https://github.com/yashhasan570/UniversalMediaCenter/wiki/view/Linux"
msgstr "Aby znaleźć więcej informacji, odwiedź https://github.com/yashhasan570/UniversalMediaCenter/wiki/view/Linux"

#~ msgctxt "#32035"
#~ msgid "It is recommended that you to upgrade to a newer version."
#~ msgstr "Zaleca się uaktualnienie do nowszej wersji."
