msgctxt "Addon Summary"
msgid "Universal Media Center Version Check checks if you are running latest released version."
msgstr "Universal Media Center Versjonsettersyn sjekker om du kjører den sist utgitte versjonen."

msgctxt "Addon Description"
msgid "Universal Media Center Version Check only supports a number of platforms/distros as releases may differ between them. For more information visit the github.com/yashhasan570/UniversalMediaCenter website."
msgstr "Universal Media Center Versjonsettersyn støtter kun noen plattformer/distribusjoner fordi utgivelser kan være forskjellige mellom dem. Besøk github.com/yashhasan570/UniversalMediaCenter for mer informasjon."

msgctxt "Addon Disclaimer"
msgid "Feel free to use this script. For information visit github.com/yashhasan570/UniversalMediaCenter"
msgstr "Du har fri tillatelse til å benytte dette skriptet. Besøk github.com/yashhasan570/UniversalMediaCenter for informasjon"

msgctxt "#32001"
msgid "We would like to recommend you to upgrade."
msgstr "Vi ønsker å anbefale at du oppgraderer."

msgctxt "#32002"
msgid "Visit Universal Media Center.tv for more information."
msgstr "Besøk Universal Media Center.tv for mer informasjon."

msgctxt "#32009"
msgid "Would you like to remove this reminder?"
msgstr "Ønsker du å fjerne denne påminnelsen?"

msgctxt "#32010"
msgid "You can enable/disable it through add-on settings."
msgstr "Du kan aktivere/deaktivere det gjennom utvidelsesinnstillingene."

msgctxt "#32011"
msgid "Use your package manager(apt) to upgrade."
msgstr "Bruk pakkebehandleren (apt) din for å oppgradere."

msgctxt "#32012"
msgid "A new version is available, do you want to upgrade now?"
msgstr "En ny versjon er tilgjengelig, ønsker du å oppgradere nå?"

msgctxt "#32013"
msgid "Upgrade successful"
msgstr "Vellykket oppgradering"

msgctxt "#32014"
msgid "Do you want to restart Universal Media Center to finish the upgrade?"
msgstr "Ønsker du å starte Universal Media Center på nytt for å fullføre oppgraderingen?"

msgctxt "#32015"
msgid "Do you want to check the repository for a new version?"
msgstr "Ønsker du å sjekke pakkebrønnen etter en ny versjon?"

msgctxt "#32016"
msgid "There is a newer stable Universal Media Center version available."
msgstr "Det er en nyere stabil Universal Media Center versjon tilgjengelig."

msgctxt "#32020"
msgid "General"
msgstr "Generelt"

msgctxt "#32021"
msgid "Enable Universal Media Center version check?"
msgstr "Aktiver Universal Media Center versjonsettersyn?"

msgctxt "#32022"
msgid "Please enter your password"
msgstr "Vennlingst skriv inn ditt passord"

msgctxt "#32023"
msgid "Linux: Upgrade complete system"
msgstr "Linux: Oppgrader hele systemet"

msgctxt "#32024"
msgid "Linux: Upgrade using apt"
msgstr "Linux: Oppgrader med apt"

#. Used in OK dialog
msgctxt "#32030"
msgid "A new stable version of Universal Media Center is available."
msgstr "En ny stabil versjon av Universal Media Center er tilgjengelig."

#. Direct people to the website. Used in OK dialog
msgctxt "#32031"
msgid "Visit http://github.com/yashhasan570/UniversalMediaCenter for more information."
msgstr "Se http://github.com/yashhasan570/UniversalMediaCenter for mer informasjon."

#. Used in OK dialog
msgctxt "#32032"
msgid "A new stable version of Universal Media Center is available."
msgstr "En ny stabil versjon av Universal Media Center er tilgjengelig."

#. Direct people to the website. Used in OK dialog
msgctxt "#32033"
msgid "Visit http://github.com/yashhasan570/UniversalMediaCenter for more information."
msgstr "Se http://github.com/yashhasan570/UniversalMediaCenter for mer informasjon."

#. For example: "You are using 13.1 prealpha while 13.2 stable is available"
msgctxt "#32034"
msgid "Using %s while %s is available."
msgstr "Bruker %s mens %s er tilgjengelig."

#. Used in OK dialog
msgctxt "#32035"
msgid "It is recommended that you upgrade to a newer version."
msgstr "Det er anbefalt å oppgradere til en nyere versjon."

# empty strings from id 32036 to 32039
msgctxt "#32040"
msgid "Your version %s of the Python cryptography module is too old. You need at least version 1.7."
msgstr ""

msgctxt "#32041"
msgid "Please upgrade your operating system."
msgstr ""

msgctxt "#32042"
msgid "For more information, see https://github.com/yashhasan570/UniversalMediaCenter/wiki/view/Linux"
msgstr ""

