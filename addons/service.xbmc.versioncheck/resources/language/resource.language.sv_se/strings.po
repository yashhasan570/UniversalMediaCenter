msgctxt "Addon Summary"
msgid "Universal Media Center Version Check checks if you are running latest released version."
msgstr "Universal Media Center Version Check kontrollerar om du använder den senaste versionen."

msgctxt "Addon Description"
msgid "Universal Media Center Version Check only supports a number of platforms/distros as releases may differ between them. For more information visit the github.com/yashhasan570/UniversalMediaCenter website."
msgstr "Universal Media Center Version Check stöder endeast ett antal plattformar/distributioner eftersom utgivningar kan skilja mellan dessa. För mer information besök github.com/yashhasan570/UniversalMediaCenter webplatsen."

msgctxt "Addon Disclaimer"
msgid "Feel free to use this script. For information visit github.com/yashhasan570/UniversalMediaCenter"
msgstr "Använd gärna detta skript. För information, besök github.com/yashhasan570/UniversalMediaCenter"

msgctxt "#32001"
msgid "We would like to recommend you to upgrade."
msgstr "Vi rekommenderar dig att uppgradera."

msgctxt "#32002"
msgid "Visit Universal Media Center.tv for more information."
msgstr "Besök Universal Media Center.tv för mer information."

msgctxt "#32009"
msgid "Would you like to remove this reminder?"
msgstr "Vill du radera denna påminnelse?"

msgctxt "#32010"
msgid "You can enable/disable it through add-on settings."
msgstr "Du kan aktivera/inaktivera detta i tilläggsinställningarna."

msgctxt "#32011"
msgid "Use your package manager(apt) to upgrade."
msgstr "Använd din pakethanterare (apt) för att uppgradera."

msgctxt "#32012"
msgid "A new version is available, do you want to upgrade now?"
msgstr "En ny version är tillgänglig, vill du uppgradera nu?"

msgctxt "#32013"
msgid "Upgrade successful"
msgstr "Uppgradering lyckades"

msgctxt "#32014"
msgid "Do you want to restart Universal Media Center to finish the upgrade?"
msgstr "Vill du starta om Universal Media Center för att slutföra uppgraderingen?"

msgctxt "#32015"
msgid "Do you want to check the repository for a new version?"
msgstr "Vill du kontrollera förrådet efter en ny version?"

msgctxt "#32016"
msgid "There is a newer stable Universal Media Center version available."
msgstr "Det finns en nyare stabil Universal Media Center-version tillgänglig."

msgctxt "#32020"
msgid "General"
msgstr "Allmänna"

msgctxt "#32021"
msgid "Enable Universal Media Center version check?"
msgstr "Aktivera Universal Media Center versionskontroll?"

msgctxt "#32022"
msgid "Please enter your password"
msgstr "Var god ange ditt lösenord"

msgctxt "#32023"
msgid "Linux: Upgrade complete system"
msgstr "Linux: Uppdatera hela systemet"

msgctxt "#32024"
msgid "Linux: Upgrade using apt"
msgstr "Linux: Uppgradera med apt"

#. Used in OK dialog
msgctxt "#32030"
msgid "A new stable version of Universal Media Center is available."
msgstr "En ny stabil Universal Media Center-version finns tillgänglig."

#. Direct people to the website. Used in OK dialog
msgctxt "#32031"
msgid "Visit http://github.com/yashhasan570/UniversalMediaCenter for more information."
msgstr "Besök Universal Media Center.tv för mer information."

#. Used in OK dialog
msgctxt "#32032"
msgid "A new stable version of Universal Media Center is available."
msgstr "En ny stabil Universal Media Center-version finns tillgänglig."

#. Direct people to the website. Used in OK dialog
msgctxt "#32033"
msgid "Visit http://github.com/yashhasan570/UniversalMediaCenter for more information."
msgstr "Besök Universal Media Center.tv för mer information."

#. For example: "You are using 13.1 prealpha while 13.2 stable is available"
msgctxt "#32034"
msgid "Using %s while %s is available."
msgstr "Använder %s medan %s är tillgänglig."

#. Used in OK dialog
msgctxt "#32035"
msgid "It is recommended that you upgrade to a newer version."
msgstr "Vi rekommenderar att du uppgraderar till en nyare version."

# empty strings from id 32036 to 32039
msgctxt "#32040"
msgid "Your version %s of the Python cryptography module is too old. You need at least version 1.7."
msgstr "Din version %s av Pythons kryptografimodul är för gammal. Du behöver minst 1.7."

msgctxt "#32041"
msgid "Please upgrade your operating system."
msgstr "Vänligen uppgradera ditt operativsystem."

msgctxt "#32042"
msgid "For more information, see https://github.com/yashhasan570/UniversalMediaCenter/wiki/view/Linux"
msgstr "För mer information, se https://github.com/yashhasan570/UniversalMediaCenter/wiki/view/Linux"

#~ msgctxt "#32035"
#~ msgid "It is recommended that you to upgrade to a newer version."
#~ msgstr "Vi rekommenderar att du uppgraderar till en nyare version."
