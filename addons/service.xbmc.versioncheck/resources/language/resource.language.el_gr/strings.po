msgctxt "Addon Summary"
msgid "Universal Media Center Version Check checks if you are running latest released version."
msgstr "Ο Έλεγχος Έκδοσης Universal Media Center εξετάζει αν έχετε την πιο πρόσφατη έκδοση του προγράμματος."

msgctxt "Addon Description"
msgid "Universal Media Center Version Check only supports a number of platforms/distros as releases may differ between them. For more information visit the github.com/yashhasan570/UniversalMediaCenter website."
msgstr "Ο Έλεγχος Έκδοσης Universal Media Center υποστηρίζει μόνο ορισμένα λειτουργικά συστήματα/διανομές, καθώς οι εκδόσεις διαφέρουν για το καθένα. Για περισσότερες πληροφορίες επισκεφθείτε το github.com/yashhasan570/UniversalMediaCenter"

msgctxt "Addon Disclaimer"
msgid "Feel free to use this script. For information visit github.com/yashhasan570/UniversalMediaCenter"
msgstr "Χρησιμοποιήστε αυτό το script ελεύθερα. Για πληροφορίες επισκεφθείτε το github.com/yashhasan570/UniversalMediaCenter"

msgctxt "#32001"
msgid "We would like to recommend you to upgrade."
msgstr "Θα σας προτείναμε να κάνετε αναβάθμιση."

msgctxt "#32002"
msgid "Visit Universal Media Center.tv for more information."
msgstr "Επισκεφθείτε το Universal Media Center.tv για περισσότερες πληροφορίες."

msgctxt "#32009"
msgid "Would you like to remove this reminder?"
msgstr "Να αφαιρεθεί αυτή η υπενθύμιση;"

msgctxt "#32010"
msgid "You can enable/disable it through add-on settings."
msgstr "Μπορείτε να την (απ)ενεργοποιήσετε από τις ρυθμίσεις του πρόσθετου."

msgctxt "#32011"
msgid "Use your package manager(apt) to upgrade."
msgstr "Χρησιμοποιήστε τη διαχείριση πακέτων (apt) για αναβάθμιση."

msgctxt "#32012"
msgid "A new version is available, do you want to upgrade now?"
msgstr "Μια νέα έκδοση είναι διαθέσιμη, να γίνει αναβάθμιση τώρα;"

msgctxt "#32013"
msgid "Upgrade successful"
msgstr "Επιτυχής Αναβάθμιση"

msgctxt "#32014"
msgid "Do you want to restart Universal Media Center to finish the upgrade?"
msgstr "Να γίνει επανεκκίνηση του Universal Media Center για να ολοκληρωθεί η αναβάθμιση;"

msgctxt "#32015"
msgid "Do you want to check the repository for a new version?"
msgstr "Να γίνει έλεγχος του αποθετηρίου για νέα έκδοση;"

msgctxt "#32016"
msgid "There is a newer stable Universal Media Center version available."
msgstr "Είναι διαθέσιμη νεώτερη σταθερή έκδοση του Universal Media Center."

msgctxt "#32020"
msgid "General"
msgstr "Γενικά"

msgctxt "#32021"
msgid "Enable Universal Media Center version check?"
msgstr "Ενεργοποίηση ελέγχου έκδοσης Universal Media Center;"

msgctxt "#32022"
msgid "Please enter your password"
msgstr "Παρακαλώ εισάγετε τον κωδικό σας"

msgctxt "#32023"
msgid "Linux: Upgrade complete system"
msgstr "Linux: Αναβάθμιση όλου του συστήματος"

msgctxt "#32024"
msgid "Linux: Upgrade using apt"
msgstr "Linux: Αναβάθμιση με χρήση apt"

#. Used in OK dialog
msgctxt "#32030"
msgid "A new stable version of Universal Media Center is available."
msgstr "Είναι διαθέσιμη νεώτερη σταθερή έκδοση του Universal Media Center."

#. Direct people to the website. Used in OK dialog
msgctxt "#32031"
msgid "Visit http://github.com/yashhasan570/UniversalMediaCenter for more information."
msgstr "Επισκεφθείτε το http://github.com/yashhasan570/UniversalMediaCenter για περισσότερες πληροφορίες."

#. Used in OK dialog
msgctxt "#32032"
msgid "A new stable version of Universal Media Center is available."
msgstr "Είναι διαθέσιμη νεώτερη σταθερή έκδοση του Universal Media Center."

#. Direct people to the website. Used in OK dialog
msgctxt "#32033"
msgid "Visit http://github.com/yashhasan570/UniversalMediaCenter for more information."
msgstr "Επισκεφθείτε το http://github.com/yashhasan570/UniversalMediaCenter για περισσότερες πληροφορίες."

#. For example: "You are using 13.1 prealpha while 13.2 stable is available"
msgctxt "#32034"
msgid "Using %s while %s is available."
msgstr "Χρησιμοποιείτε την έκδοση %s ενώ είναι διαθέσιμη η %s."

#. Used in OK dialog
msgctxt "#32035"
msgid "It is recommended that you upgrade to a newer version."
msgstr "Προτείνεται η αναβάθμιση σε νεώτερη έκδοση."

# empty strings from id 32036 to 32039
msgctxt "#32040"
msgid "Your version %s of the Python cryptography module is too old. You need at least version 1.7."
msgstr ""

msgctxt "#32041"
msgid "Please upgrade your operating system."
msgstr ""

msgctxt "#32042"
msgid "For more information, see https://github.com/yashhasan570/UniversalMediaCenter/wiki/view/Linux"
msgstr ""

