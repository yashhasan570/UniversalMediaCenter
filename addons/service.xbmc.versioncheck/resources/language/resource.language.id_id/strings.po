msgctxt "Addon Summary"
msgid "Universal Media Center Version Check checks if you are running latest released version."
msgstr "Universal Media Center Version Check mengecek apakah Anda menggunakan versi rilis terbaru."

msgctxt "Addon Description"
msgid "Universal Media Center Version Check only supports a number of platforms/distros as releases may differ between them. For more information visit the github.com/yashhasan570/UniversalMediaCenter website."
msgstr "Universal Media Center Version Check hanya mendukung beberapa platform/distro karena rilisnya mungkin berbeda-beda. Untuk informasi lebih lanjut kunjungi situs github.com/yashhasan570/UniversalMediaCenter."

msgctxt "Addon Disclaimer"
msgid "Feel free to use this script. For information visit github.com/yashhasan570/UniversalMediaCenter"
msgstr "Jangan sungkan menggunakan script ini. Untuk informasi hubungi github.com/yashhasan570/UniversalMediaCenter"

msgctxt "#32001"
msgid "We would like to recommend you to upgrade."
msgstr "Kami merekomendasikan Anda untuk upgrade."

msgctxt "#32002"
msgid "Visit Universal Media Center.tv for more information."
msgstr "Kunjungi Universal Media Center.tv untuk informasi lebih lanjut."

msgctxt "#32009"
msgid "Would you like to remove this reminder?"
msgstr "Apakah anda ingin menghapus pengingat ini?"

msgctxt "#32010"
msgid "You can enable/disable it through add-on settings."
msgstr "Anda dapat mengaktifkan/menonaktifkannya melalui pengaturan add-on."

msgctxt "#32011"
msgid "Use your package manager(apt) to upgrade."
msgstr "Gunakan manajer paket (apt) untuk upgrade."

msgctxt "#32012"
msgid "A new version is available, do you want to upgrade now?"
msgstr "Versi yang baru sudah tersedia, apakah Anda ingin upgrade sekarang?"

msgctxt "#32013"
msgid "Upgrade successful"
msgstr "Upgrade sukses"

msgctxt "#32014"
msgid "Do you want to restart Universal Media Center to finish the upgrade?"
msgstr "Apakah Anda ingin memulai ulang Universal Media Center untuk menuntaskan proses upgrade?"

msgctxt "#32015"
msgid "Do you want to check the repository for a new version?"
msgstr "Apakah Anda ingin memeriksa repositori untuk versi yang baru?"

msgctxt "#32016"
msgid "There is a newer stable Universal Media Center version available."
msgstr "Telah tersedia Universal Media Center stabil versi lebih baru."

msgctxt "#32020"
msgid "General"
msgstr "Umum"

msgctxt "#32021"
msgid "Enable Universal Media Center version check?"
msgstr "Aktifkan pengecekan versi Universal Media Center?"

msgctxt "#32022"
msgid "Please enter your password"
msgstr "Silakan masukkan kata sandi Anda"

msgctxt "#32023"
msgid "Linux: Upgrade complete system"
msgstr "Linux: Upgrade sistem seluruhnya"

msgctxt "#32024"
msgid "Linux: Upgrade using apt"
msgstr "Linux: Perbarui menggunakan apt"

# empty strings from id 32025 to 32029
#. Used in OK dialog
msgctxt "#32030"
msgid "A new stable version of Universal Media Center is available."
msgstr "Versi stabil baru dari Universal Media Center tersedia."

#. Direct people to the website. Used in OK dialog
msgctxt "#32031"
msgid "Visit http://github.com/yashhasan570/UniversalMediaCenter for more information."
msgstr "Kunjungi http://github.com/yashhasan570/UniversalMediaCenter untuk informasi lebih lanjut."

#. Used in OK dialog
msgctxt "#32032"
msgid "A new stable version of Universal Media Center is available."
msgstr "Versi stabil baru dari Universal Media Center tersedia."

#. Direct people to the website. Used in OK dialog
msgctxt "#32033"
msgid "Visit http://github.com/yashhasan570/UniversalMediaCenter for more information."
msgstr "Kunjungi http://github.com/yashhasan570/UniversalMediaCenter untuk informasi lebih lanjut."

#. For example: "You are using 13.1 prealpha while 13.2 stable is available"
msgctxt "#32034"
msgid "Using %s while %s is available."
msgstr "Menggunakan %s selagi %s tersedia."

#. Used in OK dialog
msgctxt "#32035"
msgid "It is recommended that you upgrade to a newer version."
msgstr "Disarankan agar Anda meningkatkan ke versi yang lebih baru."

# empty strings from id 32036 to 32039
msgctxt "#32040"
msgid "Your version %s of the Python cryptography module is too old. You need at least version 1.7."
msgstr "Versi %s dari modul kriptografi Python Anda terlalu tua. Anda memerlukan setidaknya versi 1.7."

msgctxt "#32041"
msgid "Please upgrade your operating system."
msgstr "Harap tingkatkan sistem operasi Anda."

msgctxt "#32042"
msgid "For more information, see https://github.com/yashhasan570/UniversalMediaCenter/wiki/view/Linux"
msgstr "Untuk informasi lebih lanjut, lihat https://github.com/yashhasan570/UniversalMediaCenter/wiki/view/Linux"
