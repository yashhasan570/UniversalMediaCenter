msgctxt "Addon Summary"
msgid "Universal Media Center Version Check checks if you are running latest released version."
msgstr "Universal Media Center Version Check comprueba si está ejecutando la última versión de Universal Media Center."

msgctxt "Addon Description"
msgid "Universal Media Center Version Check only supports a number of platforms/distros as releases may differ between them. For more information visit the github.com/yashhasan570/UniversalMediaCenter website."
msgstr "Universal Media Center Version Check solo soporta un número limitado de plataformas/distribuciones, ya que los lanzamientos pueden diferir entre ellos. Para más información, visite la web de github.com/yashhasan570/UniversalMediaCenter."

msgctxt "Addon Disclaimer"
msgid "Feel free to use this script. For information visit github.com/yashhasan570/UniversalMediaCenter"
msgstr "Puede usar libremente este programa. Para más información, visite github.com/yashhasan570/UniversalMediaCenter"

msgctxt "#32001"
msgid "We would like to recommend you to upgrade."
msgstr "Le recomendamos que actualice."

msgctxt "#32002"
msgid "Visit Universal Media Center.tv for more information."
msgstr "Visite Universal Media Center.tv para más información."

msgctxt "#32009"
msgid "Would you like to remove this reminder?"
msgstr "¿Desea eliminar este recordatorio?"

msgctxt "#32010"
msgid "You can enable/disable it through add-on settings."
msgstr "Puede activarlo/desactivarlo a través de los ajustes del add-on ."

msgctxt "#32011"
msgid "Use your package manager(apt) to upgrade."
msgstr "Use su administrador de paquetes (apt) para actualizar."

msgctxt "#32012"
msgid "A new version is available, do you want to upgrade now?"
msgstr "Está disponible una nueva versión, ¿deseas actualizar ahora?"

msgctxt "#32013"
msgid "Upgrade successful"
msgstr "Actualización correcta"

msgctxt "#32014"
msgid "Do you want to restart Universal Media Center to finish the upgrade?"
msgstr "¿Deseas reiniciar Universal Media Center para terminar la actualización?"

msgctxt "#32015"
msgid "Do you want to check the repository for a new version?"
msgstr "¿Quieres comprobar el repositorio para una nueva versión?"

msgctxt "#32016"
msgid "There is a newer stable Universal Media Center version available."
msgstr "Hay una versión de Universal Media Center estable más reciente disponible."

msgctxt "#32020"
msgid "General"
msgstr "General"

msgctxt "#32021"
msgid "Enable Universal Media Center version check?"
msgstr "¿Activar la comprobación de versión de Universal Media Center?"

msgctxt "#32022"
msgid "Please enter your password"
msgstr "Por favor introduce tu contraseña"

msgctxt "#32023"
msgid "Linux: Upgrade complete system"
msgstr "Linux: Actualizar sistema completo"

msgctxt "#32024"
msgid "Linux: Upgrade using apt"
msgstr "Linux: Actualizar usado apt"

#. Used in OK dialog
msgctxt "#32030"
msgid "A new stable version of Universal Media Center is available."
msgstr "Una nueva versión estable de Universal Media Center está disponible."

#. Direct people to the website. Used in OK dialog
msgctxt "#32031"
msgid "Visit http://github.com/yashhasan570/UniversalMediaCenter for more information."
msgstr "Visite http://github.com/yashhasan570/UniversalMediaCenter para más información."

#. Used in OK dialog
msgctxt "#32032"
msgid "A new stable version of Universal Media Center is available."
msgstr "Una nueva versión estable de Universal Media Center está disponible."

#. Direct people to the website. Used in OK dialog
msgctxt "#32033"
msgid "Visit http://github.com/yashhasan570/UniversalMediaCenter for more information."
msgstr "Visite http://github.com/yashhasan570/UniversalMediaCenter para más información."

#. For example: "You are using 13.1 prealpha while 13.2 stable is available"
msgctxt "#32034"
msgid "Using %s while %s is available."
msgstr "Usando %s mientras que %s está disponible."

#. Used in OK dialog
msgctxt "#32035"
msgid "It is recommended that you upgrade to a newer version."
msgstr "Se recomienda que actualice a una nueva versión."

# empty strings from id 32036 to 32039
msgctxt "#32040"
msgid "Your version %s of the Python cryptography module is too old. You need at least version 1.7."
msgstr "La versión %s del módulo criptográfico de Python es muy antigua. Se necesita al menos la versión 1.7."

msgctxt "#32041"
msgid "Please upgrade your operating system."
msgstr "Por favor, actualice el sistema operativo."

msgctxt "#32042"
msgid "For more information, see https://github.com/yashhasan570/UniversalMediaCenter/wiki/view/Linux"
msgstr "Para más información visite https://github.com/yashhasan570/UniversalMediaCenter/wiki/view/Linux"

#~ msgctxt "#32035"
#~ msgid "It is recommended that you to upgrade to a newer version."
#~ msgstr "Se recomienda que actualice a una nueva versión."
